# Google Maps Platform — enable Maps JS API, Places API, Map Tiles API
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to cache tiles indefinitely (no 30-day TTL). For local dev only.
# VITE_TILE_CACHE_INDEFINITE=true

# Max tile cache size in MB (default: 500). Larger values cache more locations.
# VITE_TILE_CACHE_MAX_MB=500
